<?xml version="1.0" encoding="utf-8"?>
<!-- fork: obrazovka Konexe — spojení telefonu se světem: privátní síť
     (tunel k miniserveru) a auto přes Bluetooth. Bez dataBindingu
     (findViewById), ať nevzniká vazba na upstream viewmodely. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/color_main2_000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/twentyone_tunnel_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/color_main2_800" />

        <!-- sekce: privátní síť (tunel k miniserveru) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/twentyone_section_network"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/color_main2_800" />

        <TextView
            android:id="@+id/tunnel_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp"
            android:textColor="?attr/color_main2_700" />

        <TextView
            android:id="@+id/tunnel_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="?attr/color_main2_600" />

        <TextView
            android:id="@+id/tunnel_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="?attr/color_main2_600" />

        <TextView
            android:id="@+id/tunnel_scope_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="?attr/color_main2_600" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/twentyone_access_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/color_main2_800" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/access_server_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/twentyone_access_server"
            android:textColor="?attr/color_main2_700" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/twentyone_access_server_hint"
            android:textSize="13sp"
            android:textColor="?attr/color_main2_600" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/access_internet_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/twentyone_access_internet"
            android:textColor="?attr/color_main2_700" />

        <TextView
            android:id="@+id/access_internet_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/twentyone_access_internet_hint"
            android:textSize="13sp"
            android:textColor="?attr/color_main2_600" />

        <Button
            android:id="@+id/tunnel_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/twentyone_tunnel_connect" />

        <!-- sekce: kam se ukládají nové kontakty -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/twentyone_contacts_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/color_main2_800" />

        <TextView
            android:id="@+id/contacts_target_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:textColor="?attr/color_main2_700" />

        <TextView
            android:id="@+id/contacts_target_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="?attr/color_main2_600" />

        <Button
            android:id="@+id/contacts_target_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/twentyone_contacts_target_change" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/contacts_sync_tunnel_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/twentyone_contacts_sync_tunnel"
            android:textColor="?attr/color_main2_700" />

        <TextView
            android:id="@+id/contacts_sync_tunnel_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/twentyone_contacts_sync_tunnel_hint"
            android:textSize="13sp"
            android:textColor="?attr/color_main2_600" />

        <!-- sekce: běh na pozadí (výjimka z optimalizace baterie) -->
        <TextView
            android:id="@+id/battery_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="14sp"
            android:textColor="?attr/color_main2_700" />

        <Button
            android:id="@+id/battery_fix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/twentyone_battery_fix" />

        <!-- sekce: auto přes Bluetooth (historie, zprávy, vytáčení) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/twentyone_car_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/color_main2_800" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/tunnel_car_log_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/twentyone_car_log_switch"
            android:textColor="?attr/color_main2_700" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="?attr/color_main2_600"
            android:text="@string/twentyone_car_log_hint" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/car_dialing_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/twentyone_car_switch"
            android:textColor="?attr/color_main2_700" />

        <TextView
            android:id="@+id/car_dialing_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="?attr/color_main2_600"
            android:text="@string/twentyone_car_hint" />

        <Button
            android:id="@+id/car_dialing_accounts"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/twentyone_car_open_accounts"
            android:textColor="?attr/color_main1_500" />

        <Button
            android:id="@+id/car_sms_role"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/twentyone_car_sms_title"
            android:textColor="?attr/color_main1_500" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="?attr/color_main2_600"
            android:text="@string/twentyone_car_sms_hint" />

        <!-- diagnostika je společná pro obě sekce -->
        <Button
            android:id="@+id/tunnel_diag"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/twentyone_tunnel_diag_link"
            android:textColor="?attr/color_main1_500" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:textSize="11sp"
            android:textColor="?attr/color_main2_400"
            android:text="@string/twentyone_screen_tunnel" />

    </LinearLayout>

</ScrollView>
